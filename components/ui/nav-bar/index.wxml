<view class="osn-nav-bar {{ transparent ? 'osn-nav-bar--transparent' : '' }}" style="padding-top: {{ statusBarHeight }}px;">
  <view class="osn-nav-bar__content" style="height: {{ navHeight }}px; padding-right: {{ capsuleSpace }}px;">
    <view wx:if="{{ showBack }}" class="osn-nav-bar__back" hover-class="osn-nav-bar__back--hover" bind:tap="goBack" aria-role="button" aria-label="Retour">
      <image wx:if="{{ backIcon }}" class="osn-nav-bar__back-img" src="{{ backIcon }}" />
      <text wx:else class="osn-nav-bar__back-icon">&#x2039;</text>
    </view>
    <view wx:if="{{ title }}" class="osn-nav-bar__title {{ showBack ? '' : 'osn-nav-bar__title--root' }}">
      <text class="osn-nav-bar__title-text">{{ title }}</text>
      <text wx:if="{{ sub }}" class="osn-nav-bar__sub">{{ sub }}</text>
    </view>
    <slot name="right" />
  </view>
</view>
