<view class="db-screen">
  <app-nav-bar title="Offrir un kit" sub="Ouvert à tous" backIcon="/assets/icons/back.svg" />
  <scroll-view scroll-y class="db-scroll">
    <view class="db-body">
      <view class="db-card">
        <view class="db-row">
          <image class="db-icon" src="/assets/icons/bag.svg" />
          <text class="db-bold db-grow">Pour une femme de ma famille</text>
        </view>
        <text class="db-small db-muted">Un père, un frère, un mari ou une amie peut payer le kit. La personne reçoit un code de retrait à présenter en pharmacie.</text>
        <view class="db-btn db-btn-primary" bindtap="goBuyRelative"><text>Acheter pour une proche</text></view>
      </view>

      <view class="db-card">
        <view class="db-row">
          <image src="/assets/icons/gift.svg" class="db-icon" />
          <text class="db-bold db-grow">Pour une jeune fille, via une association</text>
        </view>
        <text class="db-small db-muted">Les kits sont distribués dans les collèges et lycées par des associations partenaires. <text class="db-bold" style="color:var(--ink);">1 284</text> kits offerts ce trimestre.</text>
        <view class="db-seg" style="grid-template-columns:repeat(3,1fr);">
          <view class="db-seg-btn {{selectedAmount===500 ? 'db-seg-btn-active' : ''}}" bindtap="selectAmount" data-amount="500"><text>500</text></view>
          <view class="db-seg-btn {{selectedAmount===1500 ? 'db-seg-btn-active' : ''}}" bindtap="selectAmount" data-amount="1500"><text>1 500</text></view>
          <view class="db-seg-btn {{selectedAmount===4500 ? 'db-seg-btn-active' : ''}}" bindtap="selectAmount" data-amount="4500"><text>4 500</text></view>
        </view>
        <text class="db-small db-muted">1 kit Essentiel pour un mois</text>
        <view class="db-btn db-btn-indigo" bindtap="giveAsso"><text>Offrir {{selectedAmount}} FCFA</text></view>
        <view class="db-btn db-btn-ghost db-btn-sm" bindtap="goSolidaire"><text>Voir où vont les dons</text></view>
      </view>
    </view>
  </scroll-view>
</view>
