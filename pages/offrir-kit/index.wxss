@import "/utils/debbo.wxss";

.db-seg { display:flex; gap:8rpx; margin:16rpx 0; }
.db-seg-btn { flex:1; text-align:center; padding:16rpx 0; border:2rpx solid var(--border); border-radius:14rpx; font-size:26rpx; color:var(--txt); }
.db-seg-btn-active { border-color:var(--indigo); background:#FFF0F8; color:var(--indigo); font-weight:700; }
