<view class="db-screen">
  <app-nav-bar title="Produit" backIcon="/assets/icons/back.svg" />
  <scroll-view scroll-y class="db-scroll">
    <view class="db-body">
      <view class="db-hero-media">
        <app-image
          wx:if="{{product.image}}"
          src="{{product.image}}"
          mode="aspectFill"
          previewable
          containerStyle="width:100%;height:100%;"
          imageStyle="width:100%;height:100%;display:block;"
        />
        <view wx:if="{{product.local}}" class="db-thumb-badge"><text>Fait au Sénégal</text></view>
      </view>
      <view class="db-row" style="align-items:flex-start;">
        <view class="db-grow" style="display:flex;flex-direction:column;gap:6rpx;">
          <text class="db-bold" style="font-size:40rpx;line-height:1.2;">{{product.name}}</text>
          <text class="db-small db-muted">{{product.vendor}}</text>
        </view>
        <text class="db-bold" style="font-size:36rpx;white-space:nowrap;color:var(--accent-text);">{{product.priceLabel}}</text>
      </view>
      <text style="line-height:1.6;">{{product.desc}}</text>
      <view class="db-card">
        <view class="db-kv"><text class="db-muted">Vendu par</text><text class="db-bold">{{product.vendor}}</text></view>
        <view class="db-kv"><text class="db-muted">Réception</text><text class="db-bold">Livraison discrète ou retrait</text></view>
        <view class="db-kv"><text class="db-muted">Dans l'historique</text><text class="db-bold">Achat Bien-être</text></view>
        <view wx:if="{{product.local}}" class="db-kv"><text class="db-muted">Part pour la créatrice</text><text class="db-bold">60 % du prix</text></view>
      </view>
    </view>
  </scroll-view>
  <view class="db-footbar">
    <view class="db-btn db-btn-primary" bindtap="addToCart"><text>Ajouter au panier · {{product.priceLabel}}</text></view>
  </view>
</view>
