@import "/utils/debbo.wxss";

.reussi-hero { display:flex; flex-direction:column; align-items:center; padding:60rpx 40rpx 32rpx; gap:16rpx; }
.reussi-title { font-size:44rpx; font-weight:700; color:var(--ok); }
.reussi-sub { font-size:28rpx; color:var(--muted); text-align:center; }
.code-card { text-align:center; }
.code-label { display:block; font-size:26rpx; color:var(--muted); margin-bottom:16rpx; }
.code-tip { display:block; font-size:24rpx; color:var(--muted); margin-top:12rpx; }
