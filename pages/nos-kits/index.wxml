<view class="db-screen">
  <app-nav-bar title="Kits" backIcon="/assets/icons/back.svg" />

  <scroll-view scroll-y class="db-scroll">
    <view class="db-body">
      <text class="db-small db-muted">Préparés par les pharmacies partenaires avec des produits vendus en pharmacie, remis dans un sachet opaque. Le contenu est identique partout.</text>

      <app-card wx:for="{{kits}}" wx:key="id" containerClass="db-card db-kit">
        <view class="db-kit-media">
          <app-image
            src="{{item.image}}"
            mode="aspectFill"
            containerStyle="width:100%;height:100%;"
            imageStyle="width:100%;height:100%;display:block;"
          />
          <view class="db-chip {{item.tagClass}} db-kit-tag"><text>{{item.tag}}</text></view>
        </view>
        <view class="db-row" style="align-items:flex-start;">
          <view class="db-grow" style="display:flex;flex-direction:column;gap:4rpx;">
            <text class="db-bold" style="font-size:34rpx;">{{item.name}}</text>
            <text class="db-small db-muted">{{item.pitch}}</text>
          </view>
          <text class="db-bold" style="white-space:nowrap;color:var(--accent-text);font-size:32rpx;">{{item.priceLabel}}</text>
        </view>
        <view class="db-contents">
          <view wx:for="{{item.items}}" wx:for-item="line" wx:key="1" class="db-ci">
            <text class="db-qty">{{line[0]}}</text>
            <text>{{line[1]}}<text wx:if="{{line[2]}}" class="db-small db-muted"> · {{line[2]}}</text></text>
          </view>
        </view>
        <view class="db-btn db-btn-ghost db-btn-sm" hover-class="db-press" bindtap="goCommander" data-id="{{item.id}}"><text>Commander ce kit</text></view>
      </app-card>

      <view class="db-card">
        <text class="db-bold">Besoin d'autre chose ?</text>
        <text class="db-small db-muted">Composez votre panier dans la boutique : coupe menstruelle, culotte menstruelle, tampons, produits faits au Sénégal.</text>
        <view class="db-btn db-btn-indigo db-btn-sm" bindtap="goBoutique"><text>Voir la boutique</text></view>
      </view>
    </view>
  </scroll-view>
</view>
