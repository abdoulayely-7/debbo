/* ============================================================================
   DEBBO — Shared Design Tokens & Component Styles
   Import this in every Debbo page: @import "/utils/debbo.wxss";
   ============================================================================ */

/* --------------------------------------------------------------------------
   CSS Variables (Debbo palette)
   -------------------------------------------------------------------------- */
page {
  --bg: #FFF6FA;
  --surface: #FFFFFF;
  --sunk: #FFF0F6;
  --ink: #2B0F1C;
  --muted: #74566A;
  --line: #F6D5E3;
  --accent: #E0177A;
  --accent-ink: #FFFFFF;
  --accent-text: #B3105F;
  --accent-soft: #FFE2EF;
  --indigo: #C8136C;
  --indigo-soft: #FFDDEB;
  --fuchsia: #D9147A;
  --bonbon: #FF8CC0;
  --grad: linear-gradient(135deg, #D9147A 0%, #F2479A 55%, #FF8CC0 100%);
  --grad-btn: linear-gradient(120deg, #D9147A 0%, #F0408F 100%);
  --ok: #1D7A4C;
  --ok-soft: #DDF1E6;
  --warn: #9A5B00;
  --warn-soft: #FBEBD2;
  background-color: var(--bg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  color: var(--ink);
}

/* --------------------------------------------------------------------------
   Page Layout
   -------------------------------------------------------------------------- */
.db-screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.db-body {
  padding: 32rpx 32rpx 56rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  animation: db-rise 320ms ease-out both;
}

/* Vertical page scroller. app.wxss gives every scroll-view
   display:flex + white-space:nowrap (horizontal-carousel defaults), which
   squeezes and overflows page content: reset both here. It also needs a
   real height to scroll inside the 100vh column. */
.db-scroll {
  display: block;
  white-space: normal;
  flex: 1;
  height: 0;
}

/* Never let a section shrink below its content (overflow:hidden cards) */
.db-body > view,
.db-body > text {
  flex-shrink: 0;
}

.db-footbar {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}

/* --------------------------------------------------------------------------
   Icon Button
   -------------------------------------------------------------------------- */
.db-iconbtn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.db-iconbtn:active {
  background: var(--sunk);
}

.db-icon {
  width: 40rpx;
  height: 40rpx;
}

/* --------------------------------------------------------------------------
   Buttons
   -------------------------------------------------------------------------- */
.db-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
}

.db-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.db-btn-primary {
  background: var(--grad-btn);
  color: #fff;
  box-shadow: 0 12rpx 32rpx -16rpx var(--fuchsia);
}

.db-btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 3rpx solid var(--line);
}

.db-btn-indigo {
  background: var(--indigo-soft);
  color: var(--indigo);
}

.db-btn-danger {
  background: transparent;
  color: var(--accent-text);
  border: 3rpx solid var(--line);
}

.db-btn-sm {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  border-radius: 20rpx;
}

/* --------------------------------------------------------------------------
   Cards
   -------------------------------------------------------------------------- */
.db-card {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* --------------------------------------------------------------------------
   Chips / Badges
   -------------------------------------------------------------------------- */
.db-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--sunk);
  color: var(--muted);
}

.db-chip-ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.db-chip-ind {
  background: var(--indigo-soft);
  color: var(--indigo);
}

.db-chip-warn {
  background: var(--warn-soft);
  color: var(--warn);
}

.db-chip-acc {
  background: var(--accent-soft);
  color: var(--accent-text);
}

/* --------------------------------------------------------------------------
   Typography Utilities
   -------------------------------------------------------------------------- */
.db-small {
  font-size: 26rpx;
}

.db-muted {
  color: var(--muted);
}

.db-bold {
  font-weight: 700;
}

.db-center {
  text-align: center;
}

.db-label {
  font-size: 22rpx;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
  padding-top: 8rpx;
}

.db-sec {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 8rpx;
}

/* --------------------------------------------------------------------------
   Row / Layout
   -------------------------------------------------------------------------- */
.db-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.db-grow {
  flex: 1;
  min-width: 0;
}

/* --------------------------------------------------------------------------
   Segment Control
   -------------------------------------------------------------------------- */
.db-seg {
  display: flex;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 6rpx;
}

.db-seg-btn {
  flex: 1;
  padding: 20rpx 8rpx;
  border-radius: 18rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: var(--muted);
  text-align: center;
  transition: background 200ms ease-out, color 200ms ease-out;
}

.db-seg-btn-active {
  background: var(--ink);
  color: var(--surface);
}

/* --------------------------------------------------------------------------
   Radio List Options
   -------------------------------------------------------------------------- */
.db-opt {
  background: var(--surface);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  transition: transform 160ms ease-out;
}

.db-opt-selected {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.db-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid var(--muted);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.db-radio-checked {
  border-color: var(--accent);
  background: var(--accent);
}

/* --------------------------------------------------------------------------
   Grid 2 columns
   -------------------------------------------------------------------------- */
.db-grid2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 20rpx;
}

/* 2 columns without CSS grid (older WebViews): each child takes half */
.db-grid2 > view {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
}

.db-grid2 > .db-grid2-wide {
  width: 100%;
}

/* --------------------------------------------------------------------------
   Contents list (kit contents)
   -------------------------------------------------------------------------- */
.db-contents {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.db-ci {
  display: flex;
  gap: 20rpx;
  align-items: baseline;
  font-size: 28rpx;
}

.db-qty {
  font-weight: 700;
  font-size: 26rpx;
  min-width: 56rpx;
  color: var(--accent);
}

/* --------------------------------------------------------------------------
   Key-Value pairs
   -------------------------------------------------------------------------- */
.db-kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.db-kv:last-child {
  border-bottom: none;
}

/* --------------------------------------------------------------------------
   History items
   -------------------------------------------------------------------------- */
.db-hist {
  display: flex;
  flex-direction: column;
}

.db-it {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.db-it:last-child {
  border-bottom: none;
}

.db-av {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--sunk);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
}

.db-amt {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  font-size: 28rpx;
  white-space: nowrap;
}

/* --------------------------------------------------------------------------
   Payment Keypad
   -------------------------------------------------------------------------- */
.db-keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.db-key {
  padding: 28rpx 0;
  border-radius: 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  font-size: 44rpx;
  font-weight: 600;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.db-key:active {
  background: var(--sunk);
}

.db-key-blank {
  visibility: hidden;
}

.db-dots {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 32rpx 0;
}

.db-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--muted);
}

.db-dot-filled {
  background: var(--accent);
  border-color: var(--accent);
}

/* --------------------------------------------------------------------------
   Withdrawal Code Display
   -------------------------------------------------------------------------- */
.db-code-display {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  text-align: center;
  color: var(--ink);
  padding: 40rpx;
  background: var(--sunk);
  border-radius: 28rpx;
}

/* --------------------------------------------------------------------------
   SOS / Urgence button
   -------------------------------------------------------------------------- */
.db-sos {
  position: relative;
  overflow: hidden;
  background: var(--grad);
  border-radius: 44rpx;
  padding: 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: white;
  box-shadow: 0 24rpx 56rpx -28rpx var(--fuchsia);
}

.db-sos::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  border: 36rpx solid #fff;
  opacity: 0.12;
}

.db-sos:active {
  transform: scale(0.98);
}

.db-sos-kicker {
  font-size: 24rpx;
  font-weight: 700;
  opacity: 0.85;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.db-sos-title {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.05;
}

.db-sos-sub {
  font-size: 28rpx;
  opacity: 0.92;
}

/* --------------------------------------------------------------------------
   Home Tiles
   -------------------------------------------------------------------------- */
.db-tile {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  min-height: 208rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.db-tile:active {
  background: var(--sunk);
}

.db-tile-cy {
  background: var(--surface);
}

.db-tile-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.db-tile-title {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--ink);
}

.db-tile-sub {
  font-size: 26rpx;
  color: var(--muted);
}

/* --------------------------------------------------------------------------
   Feature cards (accueil discover section)
   -------------------------------------------------------------------------- */
.db-feat {
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.db-feat:active {
  opacity: 0.85;
}

.db-feat-kits {
  background: linear-gradient(160deg, #FFE6F1, #FFD0E5);
  color: var(--accent-text);
}

.db-feat-tips {
  background: linear-gradient(160deg, #E8F5EC, #D0EDD8);
  color: var(--ok);
}

.db-feat-soli {
  background: var(--grad);
  color: #fff;
  border-radius: 32rpx;
}

.db-feat-hist {
  background: var(--surface);
  border: 2rpx solid var(--line);
}

.db-feat-title {
  font-weight: 700;
  font-size: 30rpx;
}

/* --------------------------------------------------------------------------
   Product cards (boutique)
   -------------------------------------------------------------------------- */
.db-prod {
  height: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 16rpx 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.db-prod:active {
  background: var(--sunk);
}

.db-thumb {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--accent-soft);
  margin-bottom: 8rpx;
}

.db-thumb-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--ok);
  font-size: 20rpx;
  font-weight: 700;
}

/* Quick add: 64rpx visual, padded to a ~88rpx touch area */
.db-add {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 8rpx;
  border-radius: 50%;
  background: var(--surface);
  color: var(--accent-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(43, 15, 28, 0.15);
}

.db-add:active {
  transform: scale(0.9);
}

.db-filters {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}

.db-filter {
  flex-shrink: 0;
  display: inline-flex;
  margin-right: 12rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 600;
}

.db-filter-on {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.db-cart-btn {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.db-cart-badge {
  position: absolute;
  top: 6rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.db-prod-name {
  font-weight: 700;
  font-size: 28rpx;
}

.db-prod-vendor {
  font-size: 24rpx;
  color: var(--muted);
}

.db-prod-price {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--accent-text);
}

/* --------------------------------------------------------------------------
   Qty stepper
   -------------------------------------------------------------------------- */
.db-qty-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.db-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 32rpx;
}

.db-qty-btn:active {
  background: var(--sunk);
}

/* --------------------------------------------------------------------------
   Switch toggle
   -------------------------------------------------------------------------- */
.db-switch {
  width: 96rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--line);
  display: flex;
  align-items: center;
  padding: 6rpx;
  flex-shrink: 0;
  transition: background 0.2s;
}

.db-switch-on {
  background: var(--accent);
}

.db-switch-thumb {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: white;
  transition: transform 0.2s;
}

.db-switch-thumb-on {
  transform: translateX(40rpx);
}

/* --------------------------------------------------------------------------
   Accordion (Conseils)
   -------------------------------------------------------------------------- */
.db-accord {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
}

.db-accord-header {
  padding: 28rpx;
  font-weight: 600;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.db-accord-header:active {
  background: var(--sunk);
}

.db-accord-arrow {
  font-size: 24rpx;
  color: var(--muted);
  transition: transform 0.2s;
}

.db-accord-arrow-open {
  transform: rotate(180deg);
}

.db-accord-body {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
}

/* --------------------------------------------------------------------------
   Stats card (Solidaire)
   -------------------------------------------------------------------------- */
.db-stat {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.db-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent);
}

/* --------------------------------------------------------------------------
   Cycle ring visualization
   -------------------------------------------------------------------------- */
.db-cycle-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}

.db-cycle-info {
  font-size: 28rpx;
  color: var(--muted);
  text-align: center;
}

.db-cycle-days {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  padding: 8rpx 0;
}

.db-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  min-width: 72rpx;
  font-size: 26rpx;
}

.db-day-today {
  background: var(--sunk);
  font-weight: 700;
}

.db-day-period {
  background: var(--accent-soft);
  color: var(--accent-text);
}

.db-day-remind {
  background: var(--indigo-soft);
  color: var(--indigo);
}

/* --------------------------------------------------------------------------
   Mini transaction (accueil hist preview)
   -------------------------------------------------------------------------- */
.db-mini-tx {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--sunk);
  border-radius: 20rpx;
}

/* --------------------------------------------------------------------------
   Progress bar
   -------------------------------------------------------------------------- */
.db-goal {
  height: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 999rpx;
  overflow: hidden;
}

.db-goal-fill {
  height: 100%;
  background: white;
  border-radius: 999rpx;
}

/* --------------------------------------------------------------------------
   Myth (conseils vrai/faux)
   -------------------------------------------------------------------------- */
.db-myth {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  font-size: 28rpx;
}

/* --------------------------------------------------------------------------
   Press feedback & motion (transform/opacity only)
   -------------------------------------------------------------------------- */
.db-press {
  opacity: 0.85;
}

.db-opt:active,
.db-tile:active,
.db-prod:active,
.db-feat:active {
  transform: scale(0.98);
}

@keyframes db-rise {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .db-body { animation: none; }
  .db-opt, .db-seg-btn, .db-switch, .db-switch-thumb { transition: none; }
}

/* --------------------------------------------------------------------------
   Home extras
   -------------------------------------------------------------------------- */
.db-stat-big {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.05;
}

.db-chip-glass {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.db-goal-soft {
  background: var(--accent-soft);
}

.db-goal-soft .db-goal-fill {
  background: var(--grad-btn);
}

.db-feat-kits,
.db-feat-tips {
  min-height: 240rpx;
  box-sizing: border-box;
  justify-content: flex-end;
}

/* --------------------------------------------------------------------------
   Photo media (kits, fiche produit, services)
   -------------------------------------------------------------------------- */
.db-kit-media,
.db-hero-media,
.db-service-media {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--accent-soft);
}

.db-kit-media {
  height: 280rpx;
  border-radius: 24rpx;
}

.db-hero-media {
  height: 520rpx;
  border-radius: 32rpx;
}

.db-service-media {
  height: 240rpx;
  border-radius: 24rpx;
}

.db-kit-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
}

/* --------------------------------------------------------------------------
   Delivery banner (urgence, panier)
   -------------------------------------------------------------------------- */
.db-deliv-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #FFE2EF 0%, #FFF0F6 100%);
  border: 2rpx solid var(--line);
}

.db-deliv-moto {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  animation: db-ride 1s ease-in-out infinite alternate;
}

@keyframes db-ride {
  from { transform: translateX(-4rpx); }
  to   { transform: translateX(4rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .db-deliv-moto { animation: none; }
}
