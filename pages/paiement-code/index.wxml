<view class="db-screen">
  <view class="db-apphead">
    <view class="db-iconbtn" bindtap="goBack"><image src="/assets/icons/back.svg" class="db-icon" /></view>
    <view class="db-grow"><text class="db-apphead-title">Code secret Max it</text></view>
  </view>
  <view style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48rpx;">
    <image src="/assets/icons/lock.svg" style="width:80rpx;height:80rpx;margin-bottom:24rpx;" />
    <text class="db-bold" style="font-size:36rpx;margin-bottom:8rpx;text-align:center;">Entrez votre code secret</text>
    <text class="db-small db-muted db-center" style="text-align:center;max-width:500rpx;margin-bottom:32rpx;">Paiement de 1 500 FCFA à Achat Bien-être</text>
    <view class="db-dots">
      <view class="db-dot {{dots[0] ? 'db-dot-filled' : ''}}"></view>
      <view class="db-dot {{dots[1] ? 'db-dot-filled' : ''}}"></view>
      <view class="db-dot {{dots[2] ? 'db-dot-filled' : ''}}"></view>
      <view class="db-dot {{dots[3] ? 'db-dot-filled' : ''}}"></view>
    </view>
    <view class="db-keypad" style="width:100%;max-width:560rpx;">
      <view class="db-key" bindtap="pressKey" data-key="1"><text>1</text></view>
      <view class="db-key" bindtap="pressKey" data-key="2"><text>2</text></view>
      <view class="db-key" bindtap="pressKey" data-key="3"><text>3</text></view>
      <view class="db-key" bindtap="pressKey" data-key="4"><text>4</text></view>
      <view class="db-key" bindtap="pressKey" data-key="5"><text>5</text></view>
      <view class="db-key" bindtap="pressKey" data-key="6"><text>6</text></view>
      <view class="db-key" bindtap="pressKey" data-key="7"><text>7</text></view>
      <view class="db-key" bindtap="pressKey" data-key="8"><text>8</text></view>
      <view class="db-key" bindtap="pressKey" data-key="9"><text>9</text></view>
      <view class="db-key-blank"></view>
      <view class="db-key" bindtap="pressKey" data-key="0"><text>0</text></view>
      <view class="db-key" bindtap="pressKey" data-key="⌫"><text>⌫</text></view>
    </view>
    <text class="db-small db-muted" style="margin-top:32rpx;text-align:center;">Appuyez sur n'importe quel code à 4 chiffres</text>
  </view>
</view>
