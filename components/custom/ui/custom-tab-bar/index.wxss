/* Motion: transform / opacity only, 200ms ease-out, no motion on reduce. */
.tb {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  background: #FFFFFF;
  border-top: 1rpx solid #F6D5E3;
  box-shadow: 0 -8rpx 32rpx rgba(43, 15, 28, 0.06);
  padding: 12rpx 8rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.tb__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 96rpx;
  justify-content: flex-end;
  transition: transform 160ms ease-out;
}

.tb__item--press {
  transform: scale(0.94);
}

.tb__pill {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Active background grows in behind the icon. */
.tb__pill::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 999rpx;
  background: #FFE2EF;
  opacity: 0;
  transform: scaleX(0.5);
  transition: opacity 200ms ease-out, transform 200ms ease-out;
}

.tb__item--on .tb__pill::before {
  opacity: 1;
  transform: scaleX(1);
}

.tb__icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.tb__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #74566A;
  line-height: 1.2;
}

.tb__item--on .tb__label {
  color: #B3105F;
}

/* Raised emergency action */
.tb__item--action {
  justify-content: flex-end;
}

.tb__sos {
  width: 104rpx;
  height: 104rpx;
  margin-top: -44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D9147A 0%, #F2479A 55%, #FF8CC0 100%);
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 12rpx 28rpx -8rpx rgba(217, 20, 122, 0.55);
}

.tb__sos-icon {
  width: 48rpx;
  height: 48rpx;
}

.tb__label--sos {
  color: #B3105F;
  font-weight: 700;
}

@media (prefers-reduced-motion: reduce) {
  .tb__item,
  .tb__pill::before {
    transition: none;
  }
}
