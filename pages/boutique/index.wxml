<view class="db-screen">
  <app-nav-bar title="Boutique Debbo" sub="Pharmacies et créatrices vérifiées" showBack="{{false}}">
    <view slot="right" class="db-cart-btn" hover-class="db-press" bindtap="goPanier" aria-role="button" aria-label="Panier, {{cartCount}} article(s)">
      <image src="/assets/icons/cart.svg" class="db-icon" />
      <view wx:if="{{cartCount}}" class="db-cart-badge"><text>{{cartCount}}</text></view>
    </view>
  </app-nav-bar>

  <scroll-view scroll-y class="db-scroll">
    <view class="db-body">

      <!-- Filtres -->
      <scroll-view scroll-x class="db-filters" enable-flex>
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="db-filter {{activeFilter===item.key ? 'db-filter-on' : ''}}"
          bindtap="setFilter"
          data-cat="{{item.key}}"
        ><text>{{item.label}}</text></view>
      </scroll-view>

      <!-- Produits -->
      <view class="db-grid2">
        <view wx:for="{{filtered}}" wx:key="id" hover-class="db-press" bindtap="goFicheProduit" data-id="{{item.id}}">
          <app-card containerClass="db-prod">
            <view class="db-thumb">
              <app-image
                src="{{item.image}}"
                mode="aspectFill"
                containerStyle="width:100%;height:100%;"
                imageStyle="width:100%;height:100%;display:block;"
              />
              <view wx:if="{{item.local}}" class="db-thumb-badge"><text>Fait au Sénégal</text></view>
              <view class="db-add" catchtap="addQuick" data-id="{{item.id}}" aria-role="button" aria-label="Ajouter {{item.name}} au panier"><text>+</text></view>
            </view>
            <text class="db-prod-name">{{item.name}}</text>
            <text class="db-prod-vendor">{{item.vendor}}</text>
            <text class="db-prod-price">{{item.priceLabel}}</text>
          </app-card>
        </view>
      </view>

      <text class="db-small db-muted">Livraison discrète ou retrait en pharmacie partenaire. Libellé « Achat Bien-être » dans l'historique.</text>

    </view>
  </scroll-view>
</view>
