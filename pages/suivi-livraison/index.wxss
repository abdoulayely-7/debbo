@import "/utils/debbo.wxss";

/* Stepper colours: app-stepper reads --bs-primary, scoped to this page */
.sl {
  --bs-primary: #E0177A;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

/* --------------------------------------------------------- Status head */
.sl-head {
  flex-shrink: 0;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  padding: 24rpx 32rpx 8rpx;
}

.sl-status {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sl-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-text);
}

.sl-headline {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
  color: var(--ink);
}

.sl-eta {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--grad);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx -16rpx var(--fuchsia);
}

.sl-eta__num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.sl-eta__unit {
  font-size: 20rpx;
  font-weight: 600;
  opacity: 0.9;
}

.sl-steps {
  margin: 16rpx -8rpx 0;
}

/* --------------------------------------------------------------- Panels */
.sl-review {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.sl-panel-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.sl-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: -8rpx;
  animation: sl-panel-in 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.sl-success {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--ok-soft);
}

.sl-success__ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  animation: sl-pop 480ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.sl-success__icon {
  width: 56rpx;
  height: 56rpx;
}

.sl-place {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
}

.sl-checklist {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
}

.sl-check {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.sl-check__dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  flex-shrink: 0;
  box-sizing: border-box;
}

.sl-check--done { color: var(--ink); }
.sl-check--done .sl-check__dot { background: var(--accent); border-color: var(--accent); }
.sl-check--live { color: var(--ink); font-weight: 600; }
.sl-check--live .sl-check__dot { border-color: var(--accent); animation: sl-breathe 1.2s ease-in-out infinite; }

.sl-progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  overflow: hidden;
}

.sl-progress__bar {
  width: 40%;
  height: 100%;
  border-radius: 999rpx;
  background: var(--grad-btn);
  animation: sl-indeterminate 1.4s ease-in-out infinite;
}

.sl-stars {
  display: flex;
  gap: 16rpx;
}

.sl-star {
  font-size: 56rpx;
  line-height: 1;
  color: var(--line);
  transition: transform 160ms ease-out;
}

.sl-star:active { transform: scale(0.9); }
.sl-star--on { color: #F5A524; }

/* ------------------------------------------------------------------ Map */
.sl-map {
  position: relative;
  height: 440rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
  background-color: #F4EEF1;
  background-image:
    linear-gradient(#FFFFFF 10rpx, transparent 10rpx),
    linear-gradient(90deg, #FFFFFF 10rpx, transparent 10rpx),
    linear-gradient(#FBF7F9 4rpx, transparent 4rpx),
    linear-gradient(90deg, #FBF7F9 4rpx, transparent 4rpx);
  background-size: 220rpx 180rpx, 220rpx 180rpx, 55rpx 45rpx, 55rpx 45rpx;
}

.sl-park {
  position: absolute;
  border-radius: 24rpx;
  background: #DDEFE3;
}

.sl-park--a { left: 58%; top: 52%; width: 150rpx; height: 110rpx; }
.sl-park--b { left: 24%; top: 12%; width: 120rpx; height: 150rpx; }

.sl-sea {
  position: absolute;
  right: -80rpx;
  bottom: -80rpx;
  width: 300rpx;
  height: 260rpx;
  border-radius: 50%;
  background: #DCEBF5;
}

.sl-label {
  position: absolute;
  font-size: 20rpx;
  font-weight: 600;
  color: #9C8592;
  letter-spacing: 0.02em;
}

.sl-route {
  position: absolute;
  border-color: var(--accent);
  border-style: dashed;
  border-width: 0;
}

.sl-route--h { height: 0; border-top-width: 6rpx; margin-top: -3rpx; }
.sl-route--v { width: 0; border-left-width: 6rpx; margin-left: -3rpx; }

/* Markers are translated to the point, children centre on it */
.sl-pin,
.sl-moto {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
}

.sl-pin__dot {
  position: absolute;
  left: -32rpx;
  top: -32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(43, 15, 28, 0.18);
}

.sl-pin__dot--home {
  background: var(--accent-soft);
  border: 4rpx solid #FFFFFF;
}

.sl-pin__icon {
  width: 36rpx;
  height: 36rpx;
}

.sl-pin__halo {
  position: absolute;
  left: -56rpx;
  top: -56rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.18;
  animation: sl-breathe 2.4s ease-in-out infinite;
}

/* Courier: the transition interpolates between two setData ticks */
.sl-moto {
  z-index: 3;
  transition: transform 1.6s linear;
}

.sl-moto__bubble {
  position: absolute;
  left: -44rpx;
  top: -44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx -6rpx rgba(217, 20, 122, 0.45);
  animation: sl-bob 0.9s ease-in-out infinite alternate;
}

.sl-moto--wait .sl-moto__bubble {
  animation: none;
}

.sl-moto__img {
  width: 64rpx;
  height: 64rpx;
  transition: transform 300ms ease-out;
}

.sl-moto__img--flip {
  transform: scaleX(-1);
}

.sl-moto__pulse {
  position: absolute;
  left: -60rpx;
  top: -60rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0;
  animation: sl-ping 1.8s ease-out infinite;
}

.sl-map-chip {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.sl-courier {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--sunk);
}

.sl-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--grad);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sl-action {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sl-code {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  border: 3rpx dashed var(--accent);
}

.sl-code__value {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* ------------------------------------------------------------- Motion */
@keyframes sl-panel-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes sl-pop {
  from { opacity: 0; transform: scale(0.6); }
  to   { opacity: 1; transform: scale(1); }
}

@keyframes sl-indeterminate {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(250%); }
}

@keyframes sl-ping {
  0%   { transform: scale(0.4); opacity: 0.35; }
  100% { transform: scale(1.4); opacity: 0; }
}

@keyframes sl-breathe {
  0%, 100% { transform: scale(0.85); }
  50%      { transform: scale(1.1); }
}

@keyframes sl-bob {
  from { transform: translateY(0); }
  to   { transform: translateY(-6rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .sl-moto { transition: none; }
  .sl-panel,
  .sl-success__ring,
  .sl-progress__bar,
  .sl-check--live .sl-check__dot,
  .sl-moto__bubble,
  .sl-moto__pulse,
  .sl-pin__halo { animation: none; }
}
