/* ============================================================================
   CUSTOM NAV BAR
   ============================================================================ */

.osn-nav-bar {
  position: relative;
  z-index: 200;
  background: var(--surface, #fff);
  border-bottom: 1rpx solid var(--line, transparent);
  flex-shrink: 0;
}

.osn-nav-bar--transparent {
  background: transparent;
}

.osn-nav-bar__content {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  position: relative;
}

.osn-nav-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sunk, rgba(0, 0, 0, 0.05));
  transition: background 0.15s ease-out;
}

.osn-nav-bar__back:active,
.osn-nav-bar__back--hover {
  background: rgba(0, 0, 0, 0.1);
}

.osn-nav-bar__back-img {
  width: 40rpx;
  height: 40rpx;
}

.osn-nav-bar__back-icon {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink, #333);
  line-height: 1;
  margin-top: -4rpx;
}

.osn-nav-bar__title {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 16rpx;
}

.osn-nav-bar__title--root {
  margin-left: 16rpx;
}

.osn-nav-bar__title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink, #333);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.osn-nav-bar__sub {
  font-size: 22rpx;
  color: var(--muted, #888);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
